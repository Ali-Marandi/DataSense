      "targets": [{"expr": "sum(rate(datasense_control_plane_http_requests_total{namespace=\"$namespace\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(datasense_control_plane_http_requests_total{namespace=\"$namespace\"}[5m])), 1)", "legendFormat": "5xx ratio", "refId": "A"}],
      "title": "API error ratio",
      "type": "timeseries"
    },
    {
