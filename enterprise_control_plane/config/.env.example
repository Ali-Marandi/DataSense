# Environment and transport
DATASENSE_ENV=production
DATASENSE_PUBLIC_BASE_URL=https://control.example.com
DATASENSE_ALLOWED_HOSTS=control.example.com
DATASENSE_CORS_ORIGINS=https://app.example.com
DATASENSE_TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16

# Persistence: use managed PostgreSQL / Redis in production.
DATASENSE_DATABASE_URL=postgresql+psycopg://datasense:CHANGE_ME@postgres.example.com:5432/datasense
DATASENSE_REDIS_URL=rediss://:CHANGE_ME@redis.example.com:6380/0

# JWT: inject the PEM material or a KMS-backed signer at runtime. Never commit keys.
DATASENSE_JWT_ISSUER=https://control.example.com
DATASENSE_JWT_AUDIENCE=datasense-desktop
DATASENSE_JWT_PRIVATE_KEY_PEM_FILE=/run/secrets/datasense_jwt_private.pem
DATASENSE_JWT_PUBLIC_KEY_PEM_FILE=/run/secrets/datasense_jwt_public.pem
DATASENSE_ACCESS_TOKEN_TTL_SECONDS=600
DATASENSE_AUTH_CODE_TTL_SECONDS=90
DATASENSE_SAML_TRANSACTION_TTL_SECONDS=300

# SAML: one row per tenant lives in the database; these are global safety limits.
DATASENSE_SAML_CLOCK_SKEW_SECONDS=120
DATASENSE_SAML_SP_X509_CERT_PEM_FILE=/run/secrets/datasense_saml_sp_cert.pem
DATASENSE_SAML_SP_PRIVATE_KEY_PEM_FILE=/run/secrets/datasense_saml_sp_key.pem
DATASENSE_SAML_REQUIRE_SIGNED_ASSERTIONS=true
DATASENSE_SAML_ALLOW_IDP_INITIATED=false
DATASENSE_SAML_ENCRYPTED_ASSERTION_REQUIRED=true

# Audit and observability
DATASENSE_AUDIT_HMAC_KEY_FILE=/run/secrets/datasense_audit_hmac
DATASENSE_LOG_LEVEL=INFO
DATASENSE_DISABLE_DOCS_IN_PRODUCTION=true
